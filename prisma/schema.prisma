// ============ BRANCH ============
model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings  Booking[]
}

// ============ BOOKING ============
model Booking {
  id              String   @id @default(cuid())
  bookingRef      String   @unique // e.g. TI-20240501-001
  appointmentType String   // "store" | "pickup"

  // device info
  variantId       String
  variant         Variant   @relation(fields: [variantId], references: [id])
  finalPrice      Float
  selectedOptions Json     // store selected question options

  // customer info
  name            String
  email           String
  phone           String
  postcode        String

  // store visit
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id])
  visitDate       DateTime?

  // pickup
  address         String?
  collectionDate  DateTime?
  collectionTime  String?

  status          String   @default("pending") // "pending" | "confirmed" | "completed" | "cancelled"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ QUESTION TEMPLATE ============
model QuestionTemplate {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  options   QuestionTemplateOption[]
  variants  VariantQuestion[]
}

// ============ QUESTION TEMPLATE OPTION ============
model QuestionTemplateOption {
  id          String   @id @default(cuid())
  label       String
  priceAdjust Float    @default(0)
  isWhatsapp  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  templateId  String
  template    QuestionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  overrides   VariantQuestionOverride[]
}

// ============ VARIANT-QUESTION (Junction) ============
model VariantQuestion {
  id         String   @id @default(cuid())
  order      Int      @default(0)
  variantId  String
  templateId String
  variant    Variant          @relation(fields: [variantId], references: [id], onDelete: Cascade)
  template   QuestionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  overrides  VariantQuestionOverride[]

  @@unique([variantId, templateId])
}

// ============ VARIANT QUESTION OVERRIDE ============
// Per-variant customization of template options
model VariantQuestionOverride {
  id                String   @id @default(cuid())
  variantQuestionId String
  variantQuestion   VariantQuestion @relation(fields: [variantQuestionId], references: [id], onDelete: Cascade)
  templateOptionId  String
  templateOption    QuestionTemplateOption @relation(fields: [templateOptionId], references: [id], onDelete: Cascade)
  priceAdjust       Float    // custom price for this variant
  isHidden          Boolean  @default(false)  // hide this option for this variant
  isWhatsapp        Boolean  @default(false)  // override whatsapp setting

  @@unique([variantQuestionId, templateOptionId])
}