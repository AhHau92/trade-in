// ============ BRANCH ============
model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings  Booking[]
}

// ============ BOOKING ============
model Booking {
  id              String   @id @default(cuid())
  bookingRef      String   @unique // e.g. TI-20240501-001
  appointmentType String   // "store" | "pickup"

  // device info
  // Nullable + ON DELETE SET NULL: a booking is a historical record, so
  // deleting the product/variant it was made against later shouldn't be
  // blocked, and shouldn't touch the booking row — it should just detach
  // this link. Display code must always prefer productName/variantName
  // (the snapshots below) over this relation; the relation is only useful
  // while the variant still exists (e.g. re-deriving pricing for a refund).
  variantId       String?
  variant         Variant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Snapshots of the product/variant name at the time of booking, so that
  // renaming a product later doesn't rewrite history. Nullable because
  // bookings created before this field existed won't have it — display
  // code should fall back to variant.product.name / variant.name for those.
  productName     String?
  variantName     String?
  // Same idea as productName/variantName above, but for the branch: if a
  // branch is renamed/deactivated later, this booking still shows the name
  // it had at booking time. Only set for appointmentType "store".
  branchName      String?
  finalPriceCents Int      // stored in cents
  selectedOptions Json     // store selected question options

  // customer info
  name            String
  email           String
  phone           String
  postcode        String

  // store visit
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id])
  visitDate       DateTime?

  // pickup
  address         String?
  collectionDate  DateTime?
  collectionTime  String?

  status          String   @default("pending") // "pending" | "confirmed" | "completed" | "cancelled"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ DAILY BOOKING COUNTER ============
// Backs the human-readable sequential suffix in bookingRef (TI-YYYYMMDD-NNN).
// Incremented atomically via upsert inside a transaction so two concurrent
// bookings on the same day can never be handed the same number — unlike the
// old approach of COUNT()'ing existing rows, which raced under concurrent
// requests and could also reissue a used number if a row were ever removed.
model DailyBookingCounter {
  date  String @id // "YYYYMMDD"
  count Int    @default(0)
}

// ============ QUESTION TEMPLATE ============
model QuestionTemplate {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  // "single" = pick one option (radio-style, existing behavior).
  // "multi"  = pick any number of options (checkbox-style); their price
  // adjustments are summed. Defaults to "single" so every template created
  // before this field existed keeps behaving exactly as before.
  type      String   @default("single")
  helpText  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  options   QuestionTemplateOption[]
  variants  VariantQuestion[]
}

// ============ QUESTION TEMPLATE OPTION ============
model QuestionTemplateOption {
  id               String   @id @default(cuid())
  label            String
  priceAdjustCents Int      @default(0) // stored in cents
  isWhatsapp       Boolean  @default(false)
  // Optional richer presentation for this option on the storefront.
  imageUrl        String?
  description     String?  @db.Text
  // Only meaningful when the parent template's type is "multi" — pre-checks
  // this option when the question first renders.
  defaultChecked  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  templateId  String
  template    QuestionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  overrides   VariantQuestionOverride[]
  variantSubsetEntries VariantQuestionOption[]
}

// ============ VARIANT-QUESTION (Junction) ============
model VariantQuestion {
  id         String   @id @default(cuid())
  order      Int      @default(0)
  variantId  String
  templateId String
  variant    Variant          @relation(fields: [variantId], references: [id], onDelete: Cascade)
  template   QuestionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  overrides  VariantQuestionOverride[]
  // false (default) = legacy/unconfigured — storefront shows every option on
  // the template (today's behavior, unaffected by this feature). true =
  // admin has explicitly picked a subset via `options` below, so the
  // storefront shows ONLY those options — e.g. a variant that only offers 5
  // of a template's 200 colour options.
  optionsConfigured Boolean @default(false)
  options    VariantQuestionOption[]

  @@unique([variantId, templateId])
}

// ============ VARIANT QUESTION OPTION (subset) ============
// Which of the template's options this specific variant-question actually
// offers. Only consulted when the parent VariantQuestion.optionsConfigured
// is true; otherwise all template options are shown (see comment above).
model VariantQuestionOption {
  id                String   @id @default(cuid())
  variantQuestionId String
  variantQuestion   VariantQuestion @relation(fields: [variantQuestionId], references: [id], onDelete: Cascade)
  templateOptionId  String
  templateOption    QuestionTemplateOption @relation(fields: [templateOptionId], references: [id], onDelete: Cascade)
  order             Int      @default(0)

  @@unique([variantQuestionId, templateOptionId])
}

// ============ VARIANT QUESTION OVERRIDE ============
// Per-variant customization of template options
model VariantQuestionOverride {
  id                String   @id @default(cuid())
  variantQuestionId String
  variantQuestion   VariantQuestion @relation(fields: [variantQuestionId], references: [id], onDelete: Cascade)
  templateOptionId  String
  templateOption    QuestionTemplateOption @relation(fields: [templateOptionId], references: [id], onDelete: Cascade)
  priceAdjustCents  Int      // custom price for this variant, stored in cents
  isHidden          Boolean  @default(false)  // hide this option for this variant
  isWhatsapp        Boolean  @default(false)  // override whatsapp setting

  @@unique([variantQuestionId, templateOptionId])
}