// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ADMIN ============
model Admin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin") // "admin" | "superadmin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ SETTINGS ============
model Settings {
  id              String  @id @default(cuid())
  pickupFeeCents  Int     @default(0) // stored in cents, e.g. 1000 = $10.00
  currency        String  @default("SGD")
  whatsappNumber  String  @default("")
  notifyEmail     String  @default("")
  updatedAt       DateTime @updatedAt
}

// ============ CATEGORY ============
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  image     String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brands    CategoryBrand[]
  products  Product[]
}

// ============ BRAND ============
model Brand {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  image      String?
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  categories CategoryBrand[]
  products   Product[]
}

// ============ CATEGORY-BRAND (Junction Table) ============
model CategoryBrand {
  categoryId String
  brandId    String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([categoryId, brandId])
}

// ============ PRODUCT ============
model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String
  condition    String   @default("new")
  variantLabel String   @default("Device Built-In Storage")
  // Second axis label (e.g. "Colour"). Null = single-axis product (today's
  // behavior, unaffected) — only set this when the product's variants also
  // vary along a second dimension (e.g. Storage + Colour).
  variantLabel2 String?
  image        String?
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  // Rich content for the single product page: introContent renders above
  // the quote builder, seoContent renders below it. metaTitle/metaDescription
  // feed generateMetadata(); all four are optional and fall back to
  // name-derived defaults, so existing products are unaffected.
  introContent    String?  @db.Text
  seoContent      String?  @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  brandId      String
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants     Variant[]

  @@unique([slug, condition])
}

// ============ VARIANT ============
// e.g. iPhone 17 Pro Max 512GB, 1TB
model Variant {
  id             String   @id @default(cuid())
  name           String   // e.g. "512GB", "1TB" — the first-axis value
  // Second-axis value (e.g. "Black"), only meaningful when the parent
  // product's variantLabel2 is set. Null for single-axis products/variants
  // (today's behavior, unaffected). Several variants can share the same
  // `name` with different axis2Value — e.g. "256GB"/"Black" and
  // "256GB"/"Blue" are two separate rows that happen to share a storage tier.
  axis2Value     String?
  basePriceCents Int      // base trade-in price, stored in cents (e.g. 150000 = $1,500.00)
  isActive    Boolean  @default(true)
  // When true, this whole variant is quote-via-WhatsApp only — the storefront
  // skips straight to the WhatsApp CTA instead of the condition questions
  // (same idea as a whatsapp-only QuestionTemplateOption, but for the entire
  // variant, e.g. a brand-new device whose trade-in value needs a human).
  isWhatsappOnly Boolean @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  questions   VariantQuestion[]
  bookings    Booking[]
}

